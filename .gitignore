# ==========================================
# 1. СЕКРЕТЫ И ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ==========================================

.env
.env.local
.env.*.local

# Ключи и сертификаты
*.pem
*.key
*.crt

# ==========================================
# 2. БИНАРНЫЕ ФАЙЛЫ (Результат сборки)
# ==========================================
/assisko

# Общие скомпилированные файлы для всех ОС
*.exe
*.exe~
*.dll
*.so
*.dylib

# ==========================================
# 3. ТЕСТЫ И ПОКРЫТИЕ КОДА
# ==========================================
# Файлы, которые создаются при запуске тестов
*.test
*.out
coverage.txt
coverage.html

# ==========================================
# 4. ЗАВИСИМОСТИ (Vendor)
# ==========================================
# В современных Go-проектах папку vendor обычно не пушат,
# так как версии фиксируются в go.mod и go.sum
vendor/

# ==========================================
# 5. НАСТРОЙКИ РЕДАКТОРОВ КОДА (IDE)
# ==========================================
# JetBrains (GoLand, IntelliJ IDEA)
.idea/

# Visual Studio Code
.vscode/

# Vim / Emacs временные файлы
*.swp
*.swo
*~

